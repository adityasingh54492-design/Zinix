# Supabase Database & Auth Configuration
# Copy this file to .env.local and populate with your Supabase credentials
# If left blank, ZINX HUB automatically runs with high-performance local persistence!

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

